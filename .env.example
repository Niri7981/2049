# Optional for Discovery. Without this value the UI uses a clearly labelled,
# deterministic local planner so the discovery flow remains demoable offline.
OPENAI_API_KEY=
# Optional compatible API endpoint; omit to use the official endpoint.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.5
# responses (default), or chat_completions for compatible providers.
OPENAI_API_MODE=responses

# Payment Devnet settlement (server-side only; never expose private keys to the browser)
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
SOLANA_LOCALNET_RPC_URL=http://127.0.0.1:8899
LOCAL_USDC_MINT=
X402_FACILITATOR_URL=
DEMO_BUYER_PUBLIC_KEY=
DEMO_MERCHANT_PUBLIC_KEY=
# Run npm run wallet:setup on macOS to generate a dedicated Keychain signer.
# Configure exactly one signer source. Never use your Phantom main wallet secret.
DEMO_BUYER_KEYCHAIN_SERVICE=
DEMO_BUYER_KEYPAIR=
DEMO_BUYER_PRIVATE_KEY=
SOLANA_LOCALNET_NETWORK=solana:localnet
DAY4_API_ORIGIN=http://127.0.0.1:3000
# Optional server SQLite location. Keep it outside Git.
DAY4_SETTLEMENT_DB=.data/day4-payments.sqlite
