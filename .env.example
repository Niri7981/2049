# Optional for Discovery. Without this value the UI uses a clearly labelled,
# deterministic local planner so the discovery flow remains demoable offline.
OPENAI_API_KEY=
# Optional compatible API endpoint; omit to use the official endpoint.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.5
# responses (default), or chat_completions for compatible providers.
OPENAI_API_MODE=responses

# Payment Devnet settlement (server-side only; never expose private keys to the browser)
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
# Optional unified identity overrides. Omit rather than set empty values.
# YOSH_EXECUTION_MODE=simulated | live_devnet | live_mainnet
# live_mainnet signing requires the strict backend production gate. Missing flag means no spending.
# This is a configuration example, not permission to pay; the current App/test resources stay test-only.
# YOSH_ENABLE_MAINNET_EXECUTION=0
# Explicit Mainnet signer public identity (never the Demo buyer address):
# YOSH_MAINNET_WALLET_PUBLIC_KEY=<dedicated-mainnet-wallet-public-address>
# YOSH_MAINNET_RESOURCES is a backend-only JSON array of X402Resource registrations:
# resourceId, providerId, HTTPS request (url/method/headers/body/access), network,
# native USDC mint, decimals=6, recipient, optional exact amount and deliveryRecovery.
# No production resource, recipient, grant or daily authority is registered by default.
# Mainnet requires an explicit HTTPS X402_FACILITATOR_URL; no public/test facilitator fallback.
# Mainnet rejects DEMO_BUYER_* and DEMO_MERCHANT_PUBLIC_KEY, even empty legacy settings.
# Do not reuse this Devnet template as a Mainnet configuration.
# If mode and YOSH_ENABLE_DEVNET_PURCHASES (or APP2049 alias) are both set,
# they must agree. Remove the legacy switch to configure the new mode alone.
# SOLANA_RPC_URL must agree with the selected cluster's legacy RPC setting.
# SOLANA_GENESIS_HASH, SOLANA_NETWORK and USDC_MINT must match the environment.
# SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_LOCALNET_RPC_URL=http://127.0.0.1:8899
LOCAL_USDC_MINT=
X402_FACILITATOR_URL=
DEMO_BUYER_PUBLIC_KEY=
DEMO_MERCHANT_PUBLIC_KEY=
# Run npm run wallet:setup on macOS to generate a dedicated Keychain signer.
# Configure exactly one signer source. Never use your Phantom main wallet secret.
DEMO_BUYER_KEYCHAIN_SERVICE=
DEMO_BUYER_KEYPAIR=
DEMO_BUYER_PRIVATE_KEY=
SOLANA_LOCALNET_NETWORK=solana:localnet
DAY4_API_ORIGIN=http://127.0.0.1:3000
# Optional server SQLite location. Keep it outside Git.
DAY4_SETTLEMENT_DB=.data/day4-payments.sqlite
# The macOS App test entry is simulated by default. Do not enable real Devnet
# settlement without a specific payment authorization and a successful preflight.
YOSH_ENABLE_DEVNET_PURCHASES=0
